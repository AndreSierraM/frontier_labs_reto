{
  "rewrites": [
    { "source": "/monitor", "destination": "/monitor.html" },
    { "source": "/api/lab/(.*)", "destination": "/api/lab" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/monitor/run", "schedule": "0 6 * * *" }
  ],
  "functions": {
    "api/monitor/run.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/entregas/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}