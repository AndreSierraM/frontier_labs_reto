{
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/msg", "destination": "/api/index" },
    { "source": "/__reset", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/entregables/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
